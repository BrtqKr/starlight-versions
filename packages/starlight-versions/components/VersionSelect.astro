  //   if (matchOption) {
  //     selectBox.value = matchOption.value
  //   }
  // }
  // }
  import { actions } from 'astro:actions'

  customElements.define(
    'starlight-version-select',
    class StarlightVersionSelect extends HTMLElement {
      constructor() {
        super()

        const select = this.querySelector('select')
        if (!select) {
          console.log('NO SELECT')
          return
        }

        select?.addEventListener('change', async (event) => {
          const version = event.currentTarget.value
          console.log('SELECT ', version)

          // Creating FormData to send
          const formData = new FormData()
          formData.append('version', version)

          // Assuming your actions are set up to trigger the endpoint correctly
          await actions.updateSelectedVersion(formData)
        })

        // setSelectValueFromSessionStorage()

